#!/bin/sh
# git-flow guard: only git-flow branch names may be pushed; main/develop change only via pull requests.
# Bypass in emergencies: GITFLOW_BYPASS=1 git push ...
[ "$GITFLOW_BYPASS" = "1" ] && exit 0
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # tags etc. are fine
  [ "$local_sha" = "$zero" ] && continue                          # deleting a branch is fine
  name=${remote_ref#refs/heads/}
  case "$name" in
    main|master|develop)
      echo "git-flow: do not push to '$name' directly; open a pull request." >&2; status=1 ;;
    feature/?*|bugfix/?*|release/?*|hotfix/?*|support/?*) ;;
    *)
      echo "git-flow: branch '$name' does not follow git-flow naming" >&2
      echo "  (feature/, bugfix/, release/, hotfix/, support/)." >&2; status=1 ;;
  esac
done
exit $status
